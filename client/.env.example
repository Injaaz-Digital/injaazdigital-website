# Public site/client config
SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337

# Server-side only in Next.js. Use a Strapi token for admin pages/server actions if public permissions are locked down.
STRAPI_API_TOKEN=

# Internal admin MVP gate. This is not real authentication.
ENABLE_INTERNAL_ADMIN=false

# Do not set this unless you intentionally want to expose a token to the browser.
NEXT_PUBLIC_STRAPI_API_TOKEN=
