# Public site/client config
SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337

# Booking is owned by content-analyzer. This URL and key stay server-side.
CONTENT_ANALYZER_API_URL=http://127.0.0.1:8787
CONTENT_ANALYZER_BOOKING_KEY=

# Server-side only in Next.js. Use a Strapi token when public CMS permissions are locked down.
STRAPI_API_TOKEN=

# Publishing lifecycle (server-only, use independent random values of at least 32 characters)
STRAPI_PREVIEW_SECRET=
STRAPI_WEBHOOK_SECRET=
