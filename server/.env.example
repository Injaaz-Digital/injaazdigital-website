HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
JWT_EXPIRES_IN=7d

# API defaults
API_DEFAULT_LIMIT=24
API_MAX_LIMIT=100
FLAG_NPS=true
FLAG_PROMOTE_EE=true

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (Postgres default)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=injaaz_digital
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SCHEMA=public
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000
DATABASE_FILENAME=.tmp/data.db

# Upload provider (local | cloudinary | s3)
UPLOAD_PROVIDER=local
UPLOAD_SIZE_LIMIT=26214400

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# S3
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_REGION=
AWS_BUCKET=
AWS_ACL=public-read
AWS_SIGNED_URL_EXPIRES=900

# Forgot-password debugging (enabled by default outside production)
# LOG_FORGOT_PASSWORD_LINKS=true
# EXPOSE_ADMIN_RESET_URL_IN_RESPONSE=true

# Seed runner
SEED_INJAAZ_BOOTSTRAP_VERSION=v1
SEED_INJAAZ_FORCE=false

# Cal booking
CAL_BOOKING_WEBHOOK_SECRET=
# Set true only for local availability testing without Google credentials.
# Booking with Google Meet still requires the Google Calendar vars below.
CALENDAR_MOCK_MODE=true
# Set true temporarily to confirm slot generation without Google busy filtering.
CALENDAR_IGNORE_GOOGLE_BUSY=false
# Set true temporarily to log generated slots, Google busy intervals, and final slots.
CALENDAR_AVAILABILITY_DEBUG=false

# Google Calendar booking engine
GOOGLE_CALENDAR_CLIENT_ID=407058737509-n5r8pesrg3fav3fo0jr10nemnrlob4gp.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=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
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:1337/api/google-calendar/callback
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Africa/Casablanca
GOOGLE_CALENDAR_OAUTH_SETUP_ENABLED=false
