{
  "collectionName": "components_blocks_animated_texts",
  "info": {
    "displayName": "Animated Text",
    "description": "A focused statement revealed progressively as the visitor scrolls"
  },
  "options": {},
  "attributes": {
    "settings": { "type": "component", "component": "shared.block-settings", "repeatable": false },
    "eyebrow": {
      "type": "string",
      "maxLength": 80
    },
    "text": {
      "type": "text",
      "required": true
    },
    "highlightedText": {
      "type": "string",
      "maxLength": 180
    },
    "alignment": {
      "type": "enumeration",
      "enum": [
        "left",
        "center"
      ],
      "default": "left"
    },
    "size": {
      "type": "enumeration",
      "enum": [
        "medium",
        "large",
        "display"
      ],
      "default": "large"
    },
    "animationStyle": {
      "type": "enumeration",
      "enum": [
        "word-reveal",
        "line-reveal",
        "progressive-opacity"
      ],
      "default": "progressive-opacity"
    },
    "sticky": {
      "type": "boolean",
      "default": false
    },
    "theme": {
      "type": "enumeration",
      "enum": [
        "default",
        "muted",
        "contrast"
      ],
      "default": "default"
    }
  }
}
