{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "description": "Atomic navigation and CTA link"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "url": {
      "type": "string",
      "required": true
    },
    "isExternal": {
      "type": "boolean",
      "default": false
    },
    "style": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "tertiary"],
      "default": "primary"
    }
  }
}
