    "description": {
      "type": "text"
    },
    "placement": {
      "type": "enumeration",
      "enum": ["homepage", "related"],
      "default": "homepage"
    },
    "services": {
      "type": "component",
      "component": "shared.list-item",
      "repeatable": true,
      "max": 4
    }
  }
}
