{
  "collectionName": "components_layout_headers",
  "info": {
    "displayName": "Header",
    "description": "Global header and navigation"
  },
  "options": {},
  "attributes": {
    "logoText": {
      "type": "string",
      "default": "Injaaz Digital"
    },
    "navLinks": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true,
      "min": 1
    },
    "servicesLabel": {
      "type": "string",
      "default": "Services",
      "maxLength": 40
    },
    "serviceLinks": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true,
      "max": 8
    },
    "primaryCta": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "showLanguageSwitcher": {
      "type": "boolean",
      "default": true
    }
  }
}
