{
  "kind": "singleType",
  "collectionName": "calendar_settings",
  "info": {
    "singularName": "calendar-setting",
    "pluralName": "calendar-settings",
    "displayName": "Calendar Setting",
    "description": "Working hours and scheduling rules for bookings"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "calendarName": {
      "type": "string",
      "default": "Strategy calls"
    },
    "googleCalendarId": {
      "type": "string",
      "default": "primary"
    },
    "weeklyAvailability": {
      "type": "json"
    },
    "workingDays": {
      "type": "json",
      "required": false
    },
    "startTime": {
      "type": "string",
      "required": false
    },
    "endTime": {
      "type": "string",
      "required": false
    },
    "slotDuration": {
      "type": "integer",
      "required": true
    },
    "bufferBefore": {
      "type": "integer",
      "default": 0
    },
    "bufferAfter": {
      "type": "integer",
      "default": 15
    },
    "bufferTime": {
      "type": "integer",
      "required": false,
      "default": 15
    },
    "timezone": {
      "type": "string",
      "required": true,
      "default": "Africa/Casablanca"
    },
    "minNoticeHours": {
      "type": "integer",
      "default": 4
    },
    "maxDaysAhead": {
      "type": "integer",
      "default": 21
    },
    "maxBookingsPerDay": {
      "type": "integer",
      "default": 4
    },
    "meetingTitle": {
      "type": "string",
      "default": "Injaaz Digital Strategy Call"
    },
    "meetingDuration": {
      "type": "integer",
      "default": 30
    },
    "meetingLocation": {
      "type": "string",
      "default": "Google Meet"
    },
    "autoCreateGoogleMeet": {
      "type": "boolean",
      "default": true
    },
    "calendarId": {
      "type": "string",
      "default": "primary"
    }
  }
}
