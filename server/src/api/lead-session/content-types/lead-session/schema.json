{
  "kind": "collectionType",
  "collectionName": "lead_sessions",
  "info": {
    "singularName": "lead-session",
    "pluralName": "lead-sessions",
    "displayName": "Lead Session",
    "description": "Tracks booking funnel progress sessions"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": { "visible": false },
    "content-type-builder": { "visible": false }
  },
  "attributes": {
    "lead": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lead.lead",
      "inversedBy": "sessions",
      "required": true
    },
    "sessionToken": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "sessionTokenHash": {
      "type": "string",
      "unique": true
    },
    "expiresAt": {
      "type": "datetime"
    },
    "revokedAt": {
      "type": "datetime"
    },
    "currentStep": {
      "type": "integer",
      "default": 0
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "startedAt": {
      "type": "datetime",
      "required": true
    },
    "completedAt": {
      "type": "datetime"
    },
    "lastSeenAt": {
      "type": "datetime"
    },
    "stepperKey": { "type": "string" },
    "stepperVersion": { "type": "integer" },
    "stepperSnapshot": { "type": "json", "private": true }
  }
}
