{
  "kind": "collectionType",
  "collectionName": "offers",
  "info": {
    "singularName": "offer",
    "pluralName": "offers",
    "displayName": "Offer",
    "description": "Public and future Injaaz Digital systems offers"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 100, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "shortDescription": { "type": "text", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "positioningLine": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "outcome": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "capabilities": {
      "type": "component",
      "component": "shared.list-item",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "flowSteps": {
      "type": "component",
      "component": "shared.process-step",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "icon": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "visual": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "iconKey": { "type": "enumeration", "enum": ["growth-dashboard", "website-build", "system"], "default": "system" },
    "primaryCtaLabel": { "type": "string", "required": true, "maxLength": 80, "pluginOptions": { "i18n": { "localized": true } } },
    "primaryCtaHref": { "type": "string", "required": true },
    "displayOrder": { "type": "integer", "default": 0, "min": 0 },
    "isActive": { "type": "boolean", "default": true },
    "featuredOnHomepage": { "type": "boolean", "default": false },
    "seo": { "type": "component", "component": "shared.seo", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } }
  }
}
