{
  "kind": "collectionType",
  "collectionName": "lead_questions",
  "info": {
    "singularName": "lead-question",
    "pluralName": "lead-questions",
    "displayName": "Lead Question",
    "description": "Dynamic qualification questions for the booking funnel"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": { "visible": false },
    "content-type-builder": { "visible": false },
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "key": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["select", "radio", "checkbox", "text", "textarea", "email", "phone", "url", "number"],
      "required": true
    },
    "options": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "weight": {
      "type": "integer",
      "default": 0
    },
    "required": {
      "type": "boolean",
      "default": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "helpText": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "placeholder": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "string"
    },
    "stepper": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::booking.stepper",
      "inversedBy": "questions"
    },
    "responses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lead-response.lead-response",
      "mappedBy": "question"
    }
  }
}
