{
  "kind": "collectionType",
  "collectionName": "booking_reservations",
  "info": { "singularName": "reservation", "pluralName": "reservations", "displayName": "Booking Reservation" },
  "options": { "draftAndPublish": false },
  "pluginOptions": { "content-manager": { "visible": false }, "content-type-builder": { "visible": false } },
  "attributes": {
    "leadId": { "type": "integer", "required": true },
    "meetingId": { "type": "integer" },
    "slotKey": { "type": "string", "required": true },
    "activeSlotKey": { "type": "string", "unique": true },
    "idempotencyKey": { "type": "string", "required": true, "unique": true },
    "requestHash": { "type": "string", "required": true },
    "operationId": { "type": "string", "required": true, "unique": true },
    "state": { "type": "enumeration", "enum": ["held", "confirmed", "failed", "canceled", "expired"], "default": "held", "required": true },
    "start": { "type": "datetime", "required": true },
    "end": { "type": "datetime", "required": true },
    "timezone": { "type": "string", "required": true },
    "calendarId": { "type": "string", "required": true },
    "holdExpiresAt": { "type": "datetime", "required": true },
    "providerEventId": { "type": "string" },
    "providerSyncState": { "type": "enumeration", "enum": ["pending", "synced", "retry", "warning", "compensate", "not_required"], "default": "pending" },
    "retryCount": { "type": "integer", "default": 0 },
    "nextRetryAt": { "type": "datetime" },
    "responseJson": { "type": "json" },
    "lastMutationKey": { "type": "string" },
    "lastMutationHash": { "type": "string" },
    "failureCode": { "type": "string" },
    "failureMessage": { "type": "text" },
    "canceledAt": { "type": "datetime" },
    "cancelReason": { "type": "text" },
    "supersedesReservationId": { "type": "integer" }
  }
}
